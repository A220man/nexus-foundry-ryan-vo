# Nexus Foundry Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=Nexus Foundry
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/nexus.db

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Paths
STORAGE_PATH=./data/compositions
RENDERS_PATH=./data/renders

# Rendering
CHROME_PATH=
FFMPEG_PATH=ffmpeg

# LLM (Optional - for AI-assisted composition)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o
LLM_BASE_URL=